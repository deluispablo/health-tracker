{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "health-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "triggers": { "crons": ["*/5 * * * *", "30 4 * * *"] },
  "observability": { "enabled": true },
  "vars": { "USER_TZ": "Europe/Madrid", "PUBLIC_ORIGIN": "https://health.test" },
  // Local tests only; deploy with `--config wrangler.production.jsonc` (copy wrangler.production.example.jsonc).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "health-tracker",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
    },
  ],
}
